PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=maha_innovate
SESSION_SECRET=replace-with-a-long-random-value

# Optional Firebase Admin / Storage configuration
FIREBASE_STORAGE_BUCKET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MAX_EVIDENCE_BYTES=10485760

# Email / SMTP configuration (required for real email delivery)
# The platform works without these — in-app notifications are always stored.
# To enable real email delivery, fill in all four SMTP_* values AND EMAIL_FROM.
#
# Example using Gmail App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASSWORD=your-app-password       <- generate at myaccount.google.com/apppasswords
#   EMAIL_FROM="GovInnovate Maharashtra <youraddress@gmail.com>"
#
# Example using SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=your-sendgrid-api-key
#   EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional controlled demo seed overrides
DEMO_OFFICER_EMAIL=
DEMO_STARTUP_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_PASSWORD=
